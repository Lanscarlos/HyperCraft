# build output
/hypercraft
/hypercraft.exe
/dist/
# release archives, produced by the release workflow's packaging step
/release/

# the frontend build is generated by `make web`; only the directory is tracked
# so that //go:embed has something to point at on a fresh clone
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# panel runtime state: config, credentials, and the servers themselves
/data/

node_modules/
.DS_Store
